# Postgres (used directly by docker-compose for local dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_recipes
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_recipes

# App
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM extraction fallback (OpenRouter)
OPENROUTER_API_KEY=
# Optional override — defaults to a cheap, fast model good at structured JSON extraction.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-20260507

# YouTube Data API v3 (optional — only needed for the description-fetch import path)
YOUTUBE_API_KEY=

# Alexa API surface (SPEC §9.1) — a shared-secret bearer token, since v1 has no skill/device
# pairing yet (that's §9.2, future work). Required only to call /api/alexa/*.
ALEXA_API_TOKEN=replace-with-a-long-random-string

# deploy.sh only — the remote host this app is deployed to, not used by the app itself
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
