# ============================================
# My Recipes - Environment Variables
# ============================================
# .env        → the Pi deploy. docker compose reads it ON THE MAC (Docker context "umbrel").
# .env.local  → local dev (`npm run dev`, `npm run db:*`): same keys, localhost values; it wins
#               over .env wherever both define a key. See README "Local development".

# --- Postgres + photo storage come from the LocalInfra project (one role/database and one
# S3 bucket/key per app). Generate with:
#   DOCKER_CONTEXT=umbrel ../LocalInfra/scripts/new-project.sh my_recipes --no-redis --s3
# (it prints this block)
DATABASE_URL=postgresql://my_recipes:<password>@localinfra-postgres:5432/my_recipes
POSTGRES_HOST=localinfra-postgres
POSTGRES_PORT=5432
S3_ENDPOINT=http://localinfra-s3:3900
S3_REGION=garage
S3_BUCKET=my-recipes
S3_ACCESS_KEY_ID=<key id>
S3_SECRET_ACCESS_KEY=<secret>

# App
# Host port on the Pi (3000 is taken by yarg-aggregator). The Cloudflare tunnel doesn't use it:
# it reaches the container directly as http://my-recipes:3000.
PORT=3001
# Public URL. Baked into the client bundle at BUILD time — rebuild after changing it.
NEXT_PUBLIC_APP_URL=https://recipes.example.com
# Server timezone: decides what "today" / "this week" is for the meal plan
TZ=America/Sao_Paulo

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Same as NEXT_PUBLIC_APP_URL (OAuth callbacks are built from it)
BETTER_AUTH_URL=https://recipes.example.com

# Google OAuth (Google Cloud Console credentials)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM extraction fallback: LocalInfra's LLM gateway (it holds the OpenRouter key and this app's
# limits on paid calls). Provision the key with:
#   DOCKER_CONTEXT=umbrel ../LocalInfra/scripts/provision-app.sh my_recipes . --no-postgres --no-redis --llm
LLM_BASE_URL=http://localinfra-llm:4000/v1
LLM_API_KEY=<llm key>
# The tier (simple = free, the default / medium / hard) is picked by the user on each import.

# YouTube Data API v3 (optional — only needed for the description-fetch import path)
YOUTUBE_API_KEY=

# Alexa API surface (SPEC §9.1) — a shared-secret bearer token, since v1 has no skill/device
# pairing yet (that's §9.2, future work). Required only to call /api/alexa/*.
# Public through the tunnel: use a long random value (openssl rand -hex 32).
ALEXA_API_TOKEN=replace-with-a-long-random-string
